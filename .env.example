# Leave empty for same-origin local development.
# For the frontend, set this to the public URL of the FastAPI service.
VITE_API_BASE_URL=

# User alert settings are stored in SQLite. On production, use a durable path
# or replace the SQLite store with your managed database.
FLOATCHAT_DB_PATH=./data/floatchat.sqlite3

# Resend email delivery for custom threshold alerts.
# RESEND_API_KEY=re_...
# ALERT_FROM_EMAIL=alerts@your-verified-domain.example
