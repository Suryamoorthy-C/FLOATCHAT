# Leave empty for same-origin local development.
VITE_API_BASE_URL=

# Production persistence: keep the service-role key server-only.
# SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# SUPABASE_ANON_KEY=your-public-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_TIMEOUT_SECONDS=12

# Local fallback only when Supabase variables are absent.
FLOATCHAT_DB_PATH=./data/floatchat.sqlite3

# Resend email delivery for custom threshold alerts.
# RESEND_API_KEY=re_...
# ALERT_FROM_EMAIL=alerts@your-verified-domain.example
