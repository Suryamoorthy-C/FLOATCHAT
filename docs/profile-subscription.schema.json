{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floatchat.example/schemas/profile-subscription.schema.json",
  "title": "FLOATCHAT profile and subscription payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "subscription", "plans"],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "email", "role", "avatarUrl"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "role": { "type": "string", "minLength": 1, "maxLength": 120 },
        "avatarUrl": {
          "type": ["string", "null"],
          "format": "uri-reference",
          "description": "Relative profile-image API URL or an absolute URI from a managed image provider."
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_temperature_c", "max_temperature_c", "min_pressure_dbar", "max_pressure_dbar"],
          "properties": {
            "min_temperature_c": { "type": ["number", "null"], "minimum": -5, "maximum": 60 },
            "max_temperature_c": { "type": ["number", "null"], "minimum": -5, "maximum": 60 },
            "min_pressure_dbar": { "type": ["number", "null"], "minimum": 0, "maximum": 12000 },
            "max_pressure_dbar": { "type": ["number", "null"], "minimum": 0, "maximum": 12000 }
          }
        }
      }
    },
    "subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "planId",
        "startedAt",
        "currentPeriodStart",
        "currentPeriodEnd",
        "cancelAtPeriodEnd",
        "updatedAt"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["active", "trialing", "past_due", "canceled", "inactive"]
        },
        "planId": {
          "enum": ["starter-float", "pro-pearl-analyst", "enterprise-fleet"]
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "currentPeriodStart": { "type": "string", "format": "date-time" },
        "currentPeriodEnd": { "type": "string", "format": "date-time" },
        "cancelAtPeriodEnd": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "plans": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/plan" },
      "allOf": [
        {
          "contains": {
            "properties": { "id": { "const": "starter-float" } },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "properties": { "id": { "const": "pro-pearl-analyst" } },
            "required": ["id"]
          }
        },
        {
          "contains": {
            "properties": { "id": { "const": "enterprise-fleet" } },
            "required": ["id"]
          }
        }
      ]
    }
  },
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "monthlyPrice",
        "currency",
        "billingPeriod",
        "features"
      ],
      "properties": {
        "id": {
          "enum": ["starter-float", "pro-pearl-analyst", "enterprise-fleet"]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "monthlyPrice": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "billingPeriod": { "const": "monthly" },
        "priceLabel": { "type": "string", "maxLength": 80 },
        "monthlyPriceLabel": { "type": "string", "maxLength": 80 },
        "annualPriceLabel": { "type": "string", "maxLength": 80 },
        "pricingStatus": { "enum": ["draft", "published"] },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1, "maxLength": 160 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "status"],
                "properties": {
                  "label": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "status": { "enum": ["available", "planned"] }
                }
              }
            ]
          }
        }
      }
    }
  }
}
